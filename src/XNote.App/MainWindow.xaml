<Window x:Class="XNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XNote.App"
        Title="纪事 XNote" Height="850" Width="1250"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#FFF7F9FC" Padding="10,8" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button Content="＋ 新建" Click="New_Click" DockPanel.Dock="Left" Background="{StaticResource Accent}" Foreground="White"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="＋ 标签" Click="NewTab_Click"/>
                    <Button Content="导入" Click="Import_Click"/>
                    <Button Content="导出全部" Click="ExportAll_Click"/>
                    <Button Content="管理分类" Click="ManageCategories_Click"/>
                </StackPanel>
                <ComboBox x:Name="CategoryFilter" Width="130" Margin="10,0" DisplayMemberPath="Name"
                          SelectedValuePath="Id" SelectionChanged="Filter_Changed" VerticalContentAlignment="Center"/>
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" VerticalContentAlignment="Center" Padding="4"
                         ToolTip="搜索标题或正文（支持 2025 / 202503 / 20250315 日期）"/>
            </DockPanel>
        </Border>

        <!-- 标签条（header-only TabControl：只渲染表头，内容区由下方共享列表复用）。
             双击重命名 / 右键菜单均在代码后置里处理，避免 Style 内事件导致 BAML connectionId 冲突。 -->
        <TabControl x:Name="Tabs" DockPanel.Dock="Top" BorderThickness="0" Background="#FFF1F4F9"
                    SelectionChanged="Tabs_SelectionChanged" DisplayMemberPath="Name"
                    MouseDoubleClick="Tab_DoubleClick" PreviewMouseRightButtonUp="Tab_RightClick">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <TabPanel IsItemsHost="True" Margin="8,4,0,0"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="ToolTip" Value="双击重命名 · 右键管理"/>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#FFF7F9FC" Padding="10,4" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="就绪"/>
        </Border>

        <!-- 列表 + 右侧详情抽屉（抽屉隐藏时 Auto 列宽为 0，不占位） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- 列表：单击预览（详情抽屉），双击进编辑窗 -->
        <ListBox x:Name="NoteList" Grid.Column="0" BorderThickness="0" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="NoteList_SelectionChanged"
                 PreviewMouseLeftButtonUp="NoteList_ClickUp"
                 MouseDoubleClick="NoteList_DoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="编辑" Click="Edit_Click"/>
                    <MenuItem Header="置顶 / 取消置顶" Click="TogglePin_Click"/>
                    <MenuItem Header="导出选中" Click="ExportSelected_Click"/>
                    <Separator/>
                    <MenuItem Header="删除" Click="Delete_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" Margin="2" Background="White" CornerRadius="6" BorderBrush="#FFEDEDED" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📌" Visibility="{Binding PinVisibility}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" Margin="0,4"
                                       TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="11"/>
                                </Border>
                                <TextBlock Text="{Binding MediaText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding DateText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

            <!-- 详情抽屉：只读预览，不改数据；编辑仍走双击/右键「编辑」 -->
            <Border x:Name="DetailDrawer" Grid.Column="1" Width="380" Visibility="Collapsed"
                    Background="#FFFCFCFD" BorderBrush="#FFE0E0E0" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- 头部：标题 + 关闭 -->
                    <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
                        <Button DockPanel.Dock="Right" Content="✕" Click="CloseDetail_Click"
                                Width="26" Height="26" MinWidth="26" Padding="0" Margin="6,0,0,0"
                                VerticalAlignment="Top" ToolTip="关闭详情"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailPin" Text="📌" Margin="0,0,4,0" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="DetailTitle" FontSize="16" FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 元信息 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,8">
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="DetailCategory" FontSize="11"/>
                        </Border>
                        <TextBlock x:Name="DetailTime" Foreground="{StaticResource Muted}" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Top" Height="1" Background="#FFEDEDED"/>

                    <TextBlock x:Name="DetailEmpty" DockPanel.Dock="Top" Text="（此纪事暂无内容）"
                               Foreground="{StaticResource Muted}" Margin="12,12,12,0" Visibility="Collapsed"/>

                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Padding="8,6,8,10">
                        <ItemsControl x:Name="DetailBlocks">
                            <ItemsControl.Resources>
                                <!-- 文本块：只读，仍可选中复制 -->
                                <DataTemplate DataType="{x:Type local:TextEditBlockVM}">
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Margin="4,4"
                                             IsReadOnlyCaretVisible="False"/>
                                </DataTemplate>
                                <!-- 图片块 -->
                                <DataTemplate DataType="{x:Type local:ImageEditBlockVM}">
                                    <StackPanel Margin="4,6">
                                        <Image Source="{Binding Image}" MaxHeight="240" HorizontalAlignment="Left"
                                               Stretch="Uniform" Cursor="Hand" ToolTip="单击查看大图 / 保存"
                                               MouseLeftButtonUp="DetailViewImage_Click"/>
                                        <TextBlock Text="{Binding Alt}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                                <!-- 音频块 -->
                                <DataTemplate DataType="{x:Type local:AudioEditBlockVM}">
                                    <StackPanel Orientation="Horizontal" Margin="4,6">
                                        <Button Content="{Binding PlayLabel}" Click="DetailPlayAudio_Click" MinWidth="120"/>
                                        <TextBlock Text="🎵 音频" Foreground="{StaticResource Muted}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                                <!-- 附件块 -->
                                <DataTemplate DataType="{x:Type local:FileEditBlockVM}">
                                    <StackPanel Orientation="Horizontal" Margin="4,6">
                                        <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"/>
                                            <TextBlock Text="{Binding DisplaySize}" FontSize="11"
                                                       Foreground="{StaticResource Muted}"/>
                                        </StackPanel>
                                        <Button Content="打开" Click="DetailOpenFile_Click" Margin="8,0,0,0"
                                                MinWidth="52" Padding="8,4"
                                                ToolTip="解密到临时目录，用系统默认程序打开"/>
                                        <Button Content="另存为" Click="DetailSaveFileAs_Click" Margin="4,0,0,0"
                                                MinWidth="60" Padding="8,4" ToolTip="解密并保存到本机磁盘"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
